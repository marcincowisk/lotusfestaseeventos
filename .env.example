# Copie este arquivo para .env.local e preencha com os dados oficiais da Lótus.
# NUNCA faça commit do .env.local — ele já está no .gitignore.

# Número oficial de WhatsApp em formato internacional, só dígitos (ex: 5512999999999).
# Já existe um fallback em data/site.ts (551238834446, achado na sinalização do
# site atual) — CONFIRME com o cliente se é o número certo/habilitado para
# WhatsApp Business antes de divulgar. Definir aqui sobrescreve o fallback.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail que recebe as solicitações de orçamento do formulário de contato.
# TODO: inserir informação oficial.
CONTACT_RECEIVER_EMAIL=

# Instagram oficial (confirmado): https://www.instagram.com/lotusfestaseeventos
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/lotusfestaseeventos

# Provedor de envio de e-mail transacional para o formulário de contato (ex: Resend).
# TODO: criar conta e preencher quando o backend de envio for definido.
RESEND_API_KEY=

# Google Analytics 4 / GTM — deixar em branco até haver consentimento/config definidos.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

NEXT_PUBLIC_SITE_URL=https://www.lotusfestaseeventos.com.br
